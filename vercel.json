{
  "version": 2,
  "name": "shaman2016-api",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/tools/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/tools/tbc/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/tools/tbc/newkey.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/tools/search/zapros.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/getMe.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/dbintg/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/scratchen/desc.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/blogs/blogs.js",
      "use": "@vercel/static"
    },
    {
      "src": "api/blogs/users.js",
      "use": "@vercel/static"
    },
    {
      "src": "api/blogs/genAuthCode.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/blogs/articles.js",
      "use": "@vercel/static"
    },
    {
      "src": "api/blogs/register.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/blogs/login.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/blogs/recomendations.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/api/index.js"
    },
    {
      "src": "/tools/",
      "dest": "/api/tools/index.js"
    },
    {
      "src": "/tools/tbc/",
      "dest": "/api/tools/tbc/index.js"
    },
    {
      "src": "/tools/tbc/createKey/",
      "dest": "/api/tools/tbc/newkey.js"
    },
    {
      "src": "/tools/search/zapros",
      "dest": "/api/search/zapros.js"
    },
    {
      "src": "/getMe",
      "dest": "/api/getMe.js"
    },
    {
      "src": "/req",
      "dest": "/api/getMe.js"
    },
    {
      "src": "/getReq",
      "dest": "/api/getMe.js"
    },
    {
      "src": "/db/",
      "dest": "/api/dbintg/index.js"
    },
    {
      "src": "/scratchen/description/",
      "dest": "/api/scratchen/desc.js"
    },
    {
      "src": "/blogs/blogs",
      "dest": "/api/blogs/blogs.js"
    },
    {
      "src": "/blogs/users",
      "dest": "/api/blogs/users.js"
    },
    {
      "src": "/blogs/genCode",
      "dest": "/api/blogs/genAuthCode.js"
    },
    {
      "src": "/blogs/articles",
      "dest": "/api/blogs/articles.js"
    },
    {
      "src": "/blogs/reg",
      "dest": "/api/blogs/register.js"
    },
    {
      "src": "/blogs/login",
      "dest": "/api/blogs/login.js"
    },
    {
      "src": "/blogs/recomendations",
      "dest": "/api/blogs/recomendations.js"
    }
  ]
}
